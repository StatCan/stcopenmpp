//LABEL(functions, EN) Functions
/* NOTE(functions, EN)
	This file contains generalized functions used by other routines.
*/

classification c_lower_upper_bounds_t {
    bound_lower,  //EN LOWER_BOUND
    bound_upper   //EN UPPER_BOUND
};

range scatter_plot_elements_t { //EN Data point index
    0, 9
};

classification coordinates_x_y_t { //EN Size or probability
    coordinates_x,  //EN X  (e.g. age)
    coordinates_y   //EN Y (e.g. log cumulative hazard)
};

range cubic_spline_knots_index_t { 1, 20 }; //EN List of knots
classification cubic_spline_knots_location_coefficient_t { //EN Cubic spline knots location and coefficient
    cubic_spline_knots_location,    //EN Knot location
    cubic_spline_knots_coefficient  //EN Knot coefficient
};

classification cubic_spline_companion_t { //EN Cubic spline companion
    cubic_spline_companion_min,                 //EN Lower bound for entity used to compute spline
    cubic_spline_companion_max,                 //EN Upper bound for entity used to compute spline
    cubic_spline_companion_range_power,         //EN Power of knot range for scaling
    cubic_spline_companion_center_linear_term,  //EN Center linear term
    cubic_spline_companion_linear_coefficient,  //EN Coefficient for linear term
    cubic_spline_companion_center_cubic_term    //EN Center cubic spline term
};

parameters {
    model_generated double mg_math_constant_pi_over_sqrt3; //EN Standard deviation of logistic distribution = pi/sqrt(3)
};

bool using_fictive_person()
{
    return fictive_person_characteristics[row_1][c_db_weight] >= 0.0;
}

region_t region_of_province(int province)
{
    if (province <= 3) return atlantic;
    if (province == 4) return quebec;
    if (province == 5) return ontario;
    if (province <= 8) return prairies;
    return bc_region;
}

int pps_sampling(double u, double p[], int number_of_categories)
{
    double sum_p;
    int i;

    sum_p = 0.0;
    for (i = 0; i < number_of_categories; i++)
        sum_p += p[i];

    u = u*sum_p;
    sum_p = p[0];
    for (i = 1; u > sum_p && i < number_of_categories; i++)
        sum_p += p[i];

    return (i - 1);
}

double cubic_spline(double age_or_time, double *knots_location, double *cubic_spline_coef, double *cubic_spline_companion)
{
    int number_of_splines = 0;
    for (number_of_splines = 0; number_of_splines < SIZE(cubic_spline_knots_index_t) && knots_location[number_of_splines + 1] >= knots_location[number_of_splines]; number_of_splines++);

    number_of_splines = number_of_splines - 1;

    return cubic_spline(age_or_time, knots_location, cubic_spline_coef, cubic_spline_companion, number_of_splines);
}

double cubic_spline(double age_or_time, double *knots_location, double *cubic_spline_coef, double *cubic_spline_companion, int number_of_splines)
{
    double *two_trailing_knots = knots_location + number_of_splines;

    double capped_age_or_time = max(min(age_or_time, cubic_spline_companion[cubic_spline_companion_max]), cubic_spline_companion[cubic_spline_companion_min]);
    double scale = pow(two_trailing_knots[1] - knots_location[0], cubic_spline_companion[cubic_spline_companion_range_power]);
    double answer = (capped_age_or_time - cubic_spline_companion[cubic_spline_companion_center_linear_term]) * cubic_spline_companion[cubic_spline_companion_linear_coefficient];

    capped_age_or_time = capped_age_or_time - cubic_spline_companion[cubic_spline_companion_center_cubic_term];
    for (int knot = 0; knot < number_of_splines; knot++)
    {
        double spline_value = 0;

        spline_value += capped_age_or_time > two_trailing_knots[1] ? pow((capped_age_or_time - two_trailing_knots[1]) / scale, 3) * (two_trailing_knots[0] - knots_location[knot]) : 0.0;
        spline_value -= capped_age_or_time > two_trailing_knots[0] ? pow((capped_age_or_time - two_trailing_knots[0]) / scale, 3) * (two_trailing_knots[1] - knots_location[knot]) : 0.0;
        spline_value /= (two_trailing_knots[1] - two_trailing_knots[0]);
        spline_value += capped_age_or_time > knots_location[knot] ? pow((capped_age_or_time - knots_location[knot]) / scale, 3) : 0.0;
        spline_value *= cubic_spline_coef[knot];

        answer += spline_value;
    }
    return answer;
}

void PreSimulation2()
{
    mg_math_constant_pi_over_sqrt3 = 1.8137993642342178;
}
