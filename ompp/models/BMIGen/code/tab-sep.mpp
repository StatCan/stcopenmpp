table_group tg_sep_tables { //EN Socio-economic tables
    t_income_sep,
    t_education_sep,
    t_income_sep_prop,
    t_education_sep_prop,
    t_education_cohort_view5,
    t_income_cohort_view5,
    t_education_cross_sectional_view5,
    t_income_cross_sectional5
};

table person t_income_sep //EN Risk factors by Income by year, sex
[in_tabulation_scope && WITHIN(report_year_t, year)]
{
    sex + //EN Sex
    *
    g_income_quartile + //EN Income quartile
    *
    {
        duration(),                    //EN People count (person-years)
        duration(bmi_phac, bmi_cat_4)  //EN Obese (BMI >= 30) person-years decimals=2
    }
    *
    report_calendar_year + //EN Year
};

table person t_education_sep //EN Risk factors by Education by year, sex
[in_tabulation_scope && WITHIN(report_year_t, year)]
{
    sex + //EN Sex
    *
    g_education + //EN Self-reported Education
    *
    {
        duration(),                    //EN People count (person-years)
        duration(bmi_phac, bmi_cat_4)  //EN Obese (BMI >= 30) person-years decimals=2
    }
    *
    report_calendar_year + //EN Year
};

table person t_income_sep_prop //EN Risk factor proportions by Income by year, sex
[in_tabulation_scope && WITHIN(report_year_t, year)]
{
    sex + //EN Sex
    *
    g_income_quartile + //EN Income quartile
    *
    {
        duration(bmi_phac, bmi_cat_4) / duration() //EN Proportion obese (BMI >= 30) decimals=2
    }
    *
    report_calendar_year + //EN Year
};

table person t_education_sep_prop //EN Risk factor proportions by Education by year, sex
[in_tabulation_scope && WITHIN(report_year_t, year)]
{
    sex + //EN Sex
    *
    g_education + //EN Self-reported education
    *
    {
        duration(bmi_phac, bmi_cat_4) / duration() //EN Proportion obese (BMI >= 30) decimals=2
    }
    *
    report_calendar_year + //EN Year
};

/* NOTE(t_education_cohort_view5, EN)
This output table shows a COHORT view of the distribution of persons by education level, by sex, by year according
to age in 2001 and only follows this cohort (ie cases generated in 2001).

The calculation divides the person-years in an education level by the total person-years.

*/
table person t_education_cohort_view5 //EN Education Cohort view by year
[in_tabulation_scope && in_tabulation_scope && calendar_year_start == p_start_year]
{
    sex + //EN Sex
    *
    {
        duration(g_education, educ1) / duration(),  //EN Proportion education less than highschool decimals=2
        duration(g_education, educ2) / duration(),  //EN Proportion education secondary grad but no post-sec. decimals=2
        duration(g_education, educ3) / duration(),  //EN Proportion other post-secondary but less than bachelor decimals=2
        duration(g_education, educ4) / duration()   //EN Proportion post-secondary grad bachelor or higher decimals=2
    }
    *
    report_calendar_year + //EN Year
};

/* NOTE(t_income_cohort_view5, EN)
This output table shows a COHORT view of the distribution of persons by INCOME quartile, by sex, by year according
to age in 2001 and only follows this cohort (ie cases generated in 2001).

The calculation divides the person-years in an INCOME quartile by the total person-years.

*/
table person t_income_cohort_view5 //EN Income Cohort view by year, sex
[in_tabulation_scope && calendar_year_start == p_start_year]
{
    sex + //EN Sex
    *
    {
        duration(g_income_quartile, income_q1) / duration(),  //EN Proportion in poorest income quartile decimals=2
        duration(g_income_quartile, income_q2) / duration(),  //EN Proportion in lower-middle income quartile decimals=2
        duration(g_income_quartile, income_q3) / duration(),  //EN Proportion in upper-middle income quartile decimals=2
        duration(g_income_quartile, income_q4) / duration()   //EN Proportion in richest income quartile decimals=2
    }
    *
    report_calendar_year + //EN Year
};

/* NOTE(t_education_cross_sectional_view5, EN)
This output table shows a CROSS-SECTIONAL  view of the distribution of persons by education level, by sex, by year and 5-year age group according
to age in year being reported. Includes new cases entering Canada (births and immigrants) in years after 2001.

The calculation divides the person-years in an education level by the total person-years.

The denominator "Person-years" can be found in table Average_per_year_CohortView5.
*/
table person t_education_cross_sectional_view5 //EN Education cross-sectional view by year, sex
[in_tabulation_scope && WITHIN(report_year_t, year)]
{
    sex + //EN Sex
    *
    {
        duration(g_education, educ1) / duration(),  //EN Proportion education less than highschool decimals=2
        duration(g_education, educ2) / duration(),  //EN Proportion education secondary grad but no post-sec. decimals=2
        duration(g_education, educ3) / duration(),  //EN Proportion other post-secondary but less than bachelor decimals=2
        duration(g_education, educ4) / duration()   //EN Proportion post-secondary grad bachelor or higher decimals=2
    }
    *
    report_calendar_year + //EN Year
};

/* NOTE(t_income_cross_sectional5, EN)
This output table shows a CROSS-SECTIONAL  view of the distribution of persons by INCOME quartile, by sex, by year according
to age in year being reported. Includes new cases entering Canada (births and immigrants) in years after 2001.

The calculation divides the person-years in an INCOME quartile by the total person-years.

*/
table person t_income_cross_sectional5 //EN Income cross-sectional view by year, sex
[in_tabulation_scope && WITHIN(report_year_t, year)]
{
    sex + //EN Sex
    *
    {
        duration(g_income_quartile, income_q1) / duration(),  //EN Proportion in poorest income quartile decimals=2
        duration(g_income_quartile, income_q2) / duration(),  //EN Proportion in lower-middle income quartile decimals=2
        duration(g_income_quartile, income_q3) / duration(),  //EN Proportion in upper-middle income quartile decimals=2
        duration(g_income_quartile, income_q4) / duration()   //EN Proportion in richest income quartile decimals=2
    }
    *
    report_calendar_year + //EN Year
};
